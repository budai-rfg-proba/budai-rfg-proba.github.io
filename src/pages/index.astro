---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection, getEntry } from 'astro:content';
import { SCHOOL_NAME, withBase, slugify } from '../lib/nav';

const allNews = (await getCollection('news', ({ data }) => data.status === 'publikált')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allNews.find((n) => n.data.featured) ?? allNews[0];
const latest = allNews.filter((n) => n.slug !== featured?.slug).slice(0, 6);

const now = new Date();
const upcomingEvents = (await getCollection('events', ({ data }) => data.status === 'publikált'))
  .filter((e) => e.data.startDate >= now)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf())
  .slice(0, 4);

const highlight = await getEntry('pages', 'fooldal-kiemelt-info').catch(() => undefined);

const quickLinks = [
  { label: 'Felvételi', href: '/felveteli/', icon: '🎓' },
  { label: 'Dokumentumtár', href: '/dokumentumtar/', icon: '📁' },
  { label: 'KRÉTA', href: 'https://idp.e-kreta.hu/', icon: '🔑', external: true },
  { label: 'Kapcsolat', href: '/kapcsolat/', icon: '✉️' },
];

const schoolLifeLinks = [
  { label: 'Versenyek', href: `/hirek/kategoria/${slugify('Versenyek és eredmények')}/` },
  { label: 'Közösségek', href: '/kozossegeink/' },
  { label: 'Sport', href: `/hirek/cimke/${slugify('sport')}/` },
  { label: 'Projektek', href: '/iskolai-elet/' },
  { label: 'Rákóczi Röplap', href: `/hirek/kategoria/${slugify('Rákóczi Röplap')}/` },
];
---
<BaseLayout title={SCHOOL_NAME}>
  {highlight?.data.highlightActive && (
    <div class="highlight-bar">
      <div class="container highlight-inner">
        <span class="eyebrow">Fontos</span>
        <a href={withBase(highlight.data.highlightLink || '/')}>{highlight.data.highlightText}</a>
      </div>
    </div>
  )}

  {featured && (
    <section class="section hero-section">
      <div class="container">
        <div class="hero-card">
          <div class="hero-media">
            {featured.data.image ? (
              <img src={withBase(featured.data.image)} alt={featured.data.imageAlt || ''} />
            ) : (
              <div class="hero-placeholder" aria-hidden="true">{featured.data.category}</div>
            )}
          </div>
          <div class="hero-content">
            <span class="badge">{featured.data.category}</span>
            <h1><a href={withBase(`/hirek/${featured.slug}/`)}>{featured.data.title}</a></h1>
            <p>{featured.data.excerpt}</p>
            <a class="btn btn-primary" href={withBase(`/hirek/${featured.slug}/`)}>Tovább →</a>
          </div>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Legfrissebb hírek</h2>
        <a class="more-link" href={withBase('/hirek/')}>Összes hír →</a>
      </div>
      <div class="news-grid">
        {latest.map((entry) => <NewsCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <h2>Közelgő események</h2>
        <a class="more-link" href={withBase('/esemenyek/')}>Összes esemény →</a>
      </div>
      {upcomingEvents.length > 0 ? (
        <div class="events-grid">
          {upcomingEvents.map((entry) => <EventCard entry={entry} />)}
        </div>
      ) : (
        <p class="muted">Jelenleg nincs közelgő esemény meghirdetve.</p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <h2>Gyors elérés</h2>
      </div>
      <div class="quick-links">
        {quickLinks.map((link) => (
          <a
            class="quick-link"
            href={link.external ? link.href : withBase(link.href)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            <span class="quick-link-icon" aria-hidden="true">{link.icon}</span>
            <span>{link.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-heading">
        <h2>Iskolai élet</h2>
      </div>
      <div class="school-life-links">
        {schoolLifeLinks.map((link) => (
          <a class="school-life-link" href={withBase(link.href)}>{link.label}</a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .highlight-bar {
    background: var(--color-primary);
  }
  .highlight-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    flex-wrap: wrap;
  }
  .highlight-inner .eyebrow {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }
  .highlight-inner a {
    color: var(--color-text-inverse);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--color-text-inverse) 40%, transparent);
  }

  .hero-section {
    padding-top: clamp(var(--space-8), 5vw, var(--space-16));
  }
  .hero-card {
    display: grid;
    gap: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
  }
  @media (min-width: 860px) {
    .hero-card {
      grid-template-columns: 1.2fr 1fr;
      align-items: stretch;
    }
  }
  .hero-media {
    aspect-ratio: 16/10;
    background: var(--color-surface-offset);
  }
  @media (min-width: 860px) {
    .hero-media {
      aspect-ratio: auto;
    }
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    background: linear-gradient(135deg, var(--color-primary-highlight), var(--color-surface-offset));
    color: var(--color-primary);
  }
  .hero-content {
    padding: clamp(var(--space-6), 4vw, var(--space-10));
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    justify-content: center;
  }
  .hero-content h1 {
    font-size: var(--text-2xl);
  }
  .hero-content h1 a {
    color: var(--color-text);
  }
  .hero-content p {
    color: var(--color-text-muted);
    font-size: var(--text-base);
  }
  .hero-content .btn {
    width: fit-content;
  }

  .section-alt {
    background: var(--color-surface-offset);
  }

  .news-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .events-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  .quick-links {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  .quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
    font-weight: 600;
    color: var(--color-text);
  }
  .quick-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .quick-link-icon {
    font-size: var(--text-xl);
  }

  .school-life-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .school-life-link {
    padding: var(--space-3) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .school-life-link:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .muted {
    color: var(--color-text-muted);
  }
</style>
