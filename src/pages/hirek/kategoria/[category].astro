---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NewsCard from '../../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { slugify, withBase } from '../../../lib/nav';
import { NEWS_CATEGORIES } from '../../../content/config';

export async function getStaticPaths() {
  return NEWS_CATEGORIES.map((category) => ({
    params: { category: slugify(category) },
    props: { category },
  }));
}

const { category } = Astro.props;
const entries = (await getCollection('news', ({ data }) => data.status === 'publikált' && data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<BaseLayout title={`Kategória: ${category}`} description={`A ${category} kategóriába tartozó összes hír.`}>
  <section class="section">
    <div class="container">
      <div class="page-heading">
        <span class="eyebrow">Kategória</span>
        <h1>{category}</h1>
        <p class="muted">{entries.length} publikált hír ebben a kategóriában.</p>
      </div>
      {entries.length > 0 ? (
        <div class="news-grid">
          {entries.map((entry) => <NewsCard entry={entry} />)}
        </div>
      ) : (
        <p class="muted">Jelenleg nincs hír ebben a kategóriában.</p>
      )}
      <a class="btn btn-outline back-link" href={withBase('/hirek/')}>← Vissza az összes hírhez</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-heading {
    margin-bottom: var(--space-8);
  }
  .page-heading h1 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2);
  }
  .news-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-bottom: var(--space-8);
  }
  .muted {
    color: var(--color-text-muted);
  }
</style>
