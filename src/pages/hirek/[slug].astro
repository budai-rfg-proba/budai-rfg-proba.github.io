---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDateHu, withBase, slugify } from '../../lib/nav';

export async function getStaticPaths() {
  const entries = await getCollection('news', ({ data }) => data.status === 'publikált');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, excerpt, category, tags, pubDate, image, imageAlt, author, relatedDocument, relatedLink } = entry.data;
---
<BaseLayout title={title} description={excerpt} image={image ? withBase(image) : undefined}>
  <article class="section news-article">
    <div class="container container--narrow">
      <div class="article-meta">
        <a class="badge" href={withBase(`/hirek/kategoria/${slugify(category)}/`)}>{category}</a>
        <time datetime={pubDate.toISOString()}>{formatDateHu(pubDate)}</time>
        {author && <span>· {author}</span>}
      </div>
      <h1>{title}</h1>
      <p class="article-excerpt">{excerpt}</p>

      {image && (
        <figure class="article-media">
          <img src={withBase(image)} alt={imageAlt || ''} />
        </figure>
      )}

      <div class="article-body">
        <Content />
      </div>

      {(relatedDocument || relatedLink) && (
        <div class="related-box">
          <h2>Kapcsolódó tartalom</h2>
          {relatedDocument && <p><a href={withBase(`/dokumentumtar/#${relatedDocument}`)}>Kapcsolódó dokumentum megnyitása →</a></p>}
          {relatedLink && <p><a href={relatedLink} target="_blank" rel="noopener noreferrer">Kapcsolódó külső link →</a></p>}
        </div>
      )}

      {tags.length > 0 && (
        <ul role="list" class="tag-list">
          {tags.map((tag) => (
            <li><a class="badge badge--muted" href={withBase(`/hirek/cimke/${slugify(tag)}/`)}>#{tag}</a></li>
          ))}
        </ul>
      )}

      <a class="btn btn-outline back-link" href={withBase('/hirek/')}>← Vissza a hírekhez</a>
    </div>
  </article>
</BaseLayout>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }
  .news-article h1 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-4);
  }
  .article-excerpt {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-6);
  }
  .article-media {
    margin-bottom: var(--space-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .article-body {
    font-size: var(--text-base);
    line-height: 1.75;
  }
  .article-body :global(h2) {
    font-size: var(--text-lg);
    margin-block: var(--space-6) var(--space-3);
  }
  .article-body :global(p) {
    margin-bottom: var(--space-4);
  }
  .article-body :global(ul) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-5);
  }
  .article-body :global(li) {
    list-style: disc;
    margin-bottom: var(--space-1);
  }
  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding-left: var(--space-4);
    color: var(--color-text-muted);
    font-style: italic;
    margin-block: var(--space-4);
  }
  .related-box {
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--color-surface-offset);
    border-radius: var(--radius-lg);
  }
  .related-box h2 {
    font-size: var(--text-base);
    margin-bottom: var(--space-2);
  }
  .tag-list {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-8);
  }
  .back-link {
    margin-top: var(--space-10);
  }
</style>
