---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { getCollection } from 'astro:content';

const now = new Date();
const allEvents = await getCollection('events', ({ data }) => data.status === 'publikált');
const upcoming = allEvents
  .filter((e) => e.data.startDate >= now)
  .sort((a, b) => a.data.startDate.valueOf() - b.data.startDate.valueOf());
const past = allEvents
  .filter((e) => e.data.startDate < now)
  .sort((a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf());
---
<BaseLayout title="Események" description="Közelgő iskolai események és az eseményarchívum.">
  <section class="section">
    <div class="container">
      <div class="page-heading">
        <span class="eyebrow">Események</span>
        <h1>Közelgő és korábbi események</h1>
        <p class="muted">A lejárt események nem törlődnek — automatikusan az eseményarchívumba kerülnek.</p>
      </div>

      <h2 class="group-heading">Közelgő események</h2>
      {upcoming.length > 0 ? (
        <div class="events-grid">
          {upcoming.map((entry) => <EventCard entry={entry} />)}
        </div>
      ) : (
        <p class="muted">Jelenleg nincs meghirdetett közelgő esemény.</p>
      )}

      <h2 class="group-heading">Eseményarchívum</h2>
      {past.length > 0 ? (
        <div class="events-grid">
          {past.map((entry) => <EventCard entry={entry} />)}
        </div>
      ) : (
        <p class="muted">Az archívum jelenleg üres.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-heading {
    max-width: var(--content-narrow);
    margin-bottom: var(--space-10);
  }
  .page-heading h1 {
    font-size: var(--text-2xl);
    margin-block: var(--space-2);
  }
  .group-heading {
    font-size: var(--text-lg);
    margin-block: var(--space-8) var(--space-5);
  }
  .events-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }
  .muted {
    color: var(--color-text-muted);
  }
</style>
