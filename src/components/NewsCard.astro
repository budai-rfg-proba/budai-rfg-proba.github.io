---
import type { CollectionEntry } from 'astro:content';
import { formatDateHu, withBase, slugify } from '../lib/nav';

interface Props {
  entry: CollectionEntry<'news'>;
  featured?: boolean;
}
const { entry, featured = false } = Astro.props;
const { title, excerpt, category, tags, pubDate, image, imageAlt } = entry.data;
---
<a class={`news-card card card--interactive ${featured ? 'news-card--featured' : ''}`} href={withBase(`/hirek/${entry.slug}/`)}>
  <div class="news-card-media">
    {image ? (
      <img src={withBase(image)} alt={imageAlt || ''} loading={featured ? 'eager' : 'lazy'} />
    ) : (
      <div class="news-card-placeholder" aria-hidden="true">
        <span>{category}</span>
      </div>
    )}
  </div>
  <div class="news-card-body">
    <div class="news-card-meta">
      <a class="badge" href={withBase(`/hirek/kategoria/${slugify(category)}/`)} onclick="event.stopPropagation()">{category}</a>
      <time datetime={pubDate.toISOString()}>{formatDateHu(pubDate)}</time>
    </div>
    <h3>{title}</h3>
    <p class="news-card-excerpt">{excerpt}</p>
    {tags.length > 0 && (
      <ul role="list" class="news-card-tags">
        {tags.slice(0, 3).map((tag) => (
          <li class="badge badge--muted">#{tag}</li>
        ))}
      </ul>
    )}
  </div>
</a>

<style>
  .news-card {
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    height: 100%;
  }
  .news-card-media {
    aspect-ratio: 16/9;
    background: var(--color-surface-offset);
    overflow: hidden;
  }
  .news-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .news-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-primary-highlight), var(--color-surface-offset));
    color: var(--color-primary);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-align: center;
    padding: var(--space-4);
  }
  .news-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }
  .news-card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .news-card-body h3 {
    font-size: var(--text-lg);
    font-weight: 600;
  }
  .news-card--featured .news-card-body h3 {
    font-size: var(--text-xl);
  }
  .news-card-excerpt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    flex: 1;
  }
  .news-card-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }
</style>
