---
import Logo from './Logo.astro';
import { MAIN_NAV, SCHOOL_SHORT, KRETA_URL, withBase } from '../lib/nav';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  const base = import.meta.env.BASE_URL;
  const full = withBase(href);
  return currentPath === full || (href !== '/' && currentPath.startsWith(full));
}
---
<header class="site-header">
  <div class="utility-bar">
    <div class="container utility-inner">
      <a class="brand" href={withBase('/')}>
        <Logo size={36} />
        <span class="brand-name">{SCHOOL_SHORT}</span>
      </a>

      <div class="utility-actions">
        <form class="search-form" action={withBase('/kereses/')} method="get" role="search">
          <label class="sr-only" for="site-search">Keresés a honlapon</label>
          <input id="site-search" name="q" type="search" placeholder="Keresés…" autocomplete="off" />
          <button type="submit" aria-label="Keresés">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
          </button>
        </form>

        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Sötét mód váltása">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
        </button>

        <a class="kreta-btn" href={KRETA_URL} target="_blank" rel="noopener noreferrer">
          KRÉTA
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav" data-nav-toggle>
          <span class="sr-only">Menü megnyitása</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="main-nav" id="main-nav" data-nav-panel aria-label="Főmenü">
    <div class="container">
      <ul role="list" class="nav-list">
        {MAIN_NAV.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-divider);
  }
  .utility-bar {
    padding-block: var(--space-3);
  }
  .utility-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    line-height: 1.2;
    max-width: 22ch;
  }
  @media (min-width: 640px) {
    .brand-name {
      font-size: var(--text-base);
    }
  }

  .utility-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .search-form {
    display: none;
    align-items: center;
    background: var(--color-surface-offset);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding-inline: var(--space-3);
  }
  @media (min-width: 900px) {
    .search-form {
      display: flex;
    }
  }
  .search-form input {
    background: none;
    border: none;
    padding: var(--space-2) var(--space-1);
    font-size: var(--text-sm);
    width: 12rem;
  }
  .search-form input:focus {
    outline: none;
  }
  .search-form button {
    color: var(--color-text-muted);
    display: flex;
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
  }
  .theme-toggle:hover {
    background: var(--color-surface-offset);
    color: var(--color-text);
  }

  .kreta-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
  }
  .kreta-btn:hover {
    background: var(--color-primary-hover);
  }

  .nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--color-text);
  }
  @media (min-width: 900px) {
    .nav-toggle {
      display: none;
    }
  }

  .main-nav {
    border-top: 1px solid var(--color-divider);
    background: var(--color-surface-2);
    display: none;
  }
  .main-nav[data-open='true'] {
    display: block;
  }
  @media (min-width: 900px) {
    .main-nav {
      display: block;
    }
  }
  .nav-list {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-2);
  }
  @media (min-width: 900px) {
    .nav-list {
      flex-direction: row;
      gap: var(--space-2);
      overflow-x: auto;
    }
  }
  .nav-list a {
    display: block;
    padding: var(--space-3) var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
  }
  .nav-list a:hover {
    color: var(--color-primary);
  }
  .nav-list a[aria-current='page'] {
    color: var(--color-primary);
    border-color: var(--color-primary);
  }
</style>

<script is:inline>
  (function () {
    var toggle = document.querySelector('[data-nav-toggle]');
    var panel = document.querySelector('[data-nav-panel]');
    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var open = panel.getAttribute('data-open') === 'true';
        panel.setAttribute('data-open', open ? 'false' : 'true');
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    }

    var themeBtn = document.querySelector('[data-theme-toggle]');
    var root = document.documentElement;
    if (themeBtn) {
      themeBtn.addEventListener('click', function () {
        var current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        var next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        themeBtn.setAttribute('aria-label', next === 'dark' ? 'Világos mód váltása' : 'Sötét mód váltása');
        themeBtn.innerHTML =
          next === 'dark'
            ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>'
            : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
      });
    }
  })();
</script>
